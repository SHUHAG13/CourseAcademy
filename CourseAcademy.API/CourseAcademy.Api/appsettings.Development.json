{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=CourseAcademyDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": true
  },
  "Payments": {
    "Gateway": "demo"
  },
  "Streaming": {
    "Mode": "Fake"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
